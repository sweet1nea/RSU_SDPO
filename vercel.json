   {
     "builds": [
       {
         "src": "server/app.js",
         "use": "@vercel/node",
         "config": { "includeFiles": ["client/**"] }
       }
     ],
     "routes": [{ "src": "/(.*)", "dest": "server/app.js" }],
     "crons": [{ "path": "/api/cron/sweep", "schedule": "0 0 * * *" }]
   }