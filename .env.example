# Server
PORT=3000
NODE_ENV=development

# Vercel Cron Jobs (production only)
# Set this in the Vercel dashboard's environment variables, not here — it
# authenticates GET /api/cron/sweep (see vercel.json's `crons` entry and
# server/routes/cron.routes.js) so that route can't be triggered by anyone
# who finds the URL. Any long random string works; Vercel sends it back as
# `Authorization: Bearer <value>` on its own scheduled invocations. Not
# needed for local dev — server/app.js still runs the sweeps itself there.
CRON_SECRET=

# --- Database ---
# Supabase Postgres — used for every environment (dev and deployment alike).
# Get this from your Supabase project: Connect button (top of dashboard) ->
# Direct tab for the parameters, but use the SESSION POOLER host/port shown
# under Project Settings -> Database -> Connection pooling (the direct-
# connection host is IPv6-only and unreachable from most networks).
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
# Get GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET from the Google Cloud Console:
# APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web application).
# GOOGLE_CALLBACK_URL must exactly match a URI registered under that client's
# "Authorized redirect URIs" — it is server/routes/auth.routes.js's
# GET /api/auth/google/callback route, on whichever host this server is
# actually reachable at.
# Local dev example: http://localhost:3000/api/auth/google/callback
# Production example: https://<your-deployed-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Meta OAuth (optional)
META_CLIENT_ID=
META_CLIENT_SECRET=

# Email (Gmail SMTP - used in both development and production)
# GMAIL_SMTP_PASS must be a Gmail "App Password" (Google Account -> Security
# -> 2-Step Verification -> App passwords), not the account's login password
# — Google blocks plain-password SMTP login. Requires 2-Step Verification to
# be turned on for the sending account.
GMAIL_SMTP_USER=
GMAIL_SMTP_PASS=

# SMS (Semaphore)
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

# File Uploads
MAX_UPLOAD_SIZE_MB=5

# --- File Storage (Supabase Storage) ---
# Borrower valid IDs / authorization documents are stored in a private
# Supabase Storage bucket, uploaded/downloaded server-side only via the
# service role key (never exposed to the browser).
# Get these from your Supabase project: Project Settings -> API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=borrower-documents
# Equipment listing photos (Equipment Showroom) — same private-bucket
# pattern as above, served back through GET /api/equipment/:id/photo
# rather than a direct Storage URL. Create this bucket in the same
# Supabase project (Storage -> New bucket) before uploading any photos.
SUPABASE_EQUIPMENT_PHOTOS_BUCKET=equipment-photos
